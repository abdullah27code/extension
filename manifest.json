{
  "manifest_version": 3,
  "name": "TikTok Daily Share Automation",
  "version": "1.0.0",
  "description": "Saves a TikTok video URL and automates share interaction once per day.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
