{
  "manifest_version": 3,
  "name": "Page Helper Extension",
  "version": "1.1.0",
  "description": "Popup button changes page background and logs image URLs.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
