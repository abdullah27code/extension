{
  "manifest_version": 3,
  "name": "LinkedIn AI Job Assistant",
  "version": "2.0.1",
  "description": "Extracts LinkedIn job details and generates a personalized AI application message.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn AI Job Assistant"
  }
}
